parameters:
    level: 9
    paths:
        - src
        - config
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: missingType.iterableValue
        - message: '#Access to protected property Symfony\\Component\\HttpKernel\\Kernel::\$startTime.#'
          path: 'src/Http/KernelHandler.php'
        - message: '#Call to an undefined method#'
          path: 'src/DependencyInjection'
        # Optional-dependency / version-dependent checks differ between lowest and highest deps
        - identifier: function.impossibleType
        - identifier: property.unusedType
          path: 'src/Worker/HttpWorker.php'
